page {
  background: #f5f7fb;
  color: #101828;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
}

.section {
  background: #ffffff;
  border: 1rpx solid #e4e7ec;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.muted {
  color: #667085;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  line-height: normal;
  border-radius: 14rpx;
  background: #155eef;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  line-height: normal;
  border-radius: 14rpx;
  background: #eef4ff;
  color: #155eef;
  font-size: 28rpx;
  font-weight: 600;
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  line-height: normal;
  border-radius: 12rpx;
  background: #ffffff;
  color: #344054;
  border: 1rpx solid #d0d5dd;
  font-size: 26rpx;
}

.field-label {
  display: block;
  margin: 0 0 12rpx;
  color: #344054;
  font-size: 26rpx;
  font-weight: 600;
}

.input,
.textarea {
  width: 100%;
  border: 1rpx solid #d0d5dd;
  border-radius: 14rpx;
  background: #ffffff;
  color: #101828;
  font-size: 28rpx;
}

.input {
  height: 84rpx;
  padding: 0 22rpx;
}

.textarea {
  min-height: 300rpx;
  padding: 20rpx 22rpx;
  line-height: 1.55;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #ecfdf3;
  color: #067647;
  font-size: 22rpx;
  font-weight: 600;
}
